# ---- Google (Gmail) ----
# สร้างที่ Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# Application type: Web application
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ---- Google Calendar ----
# ใช้ OAuth ตัวเดียวกับ Gmail ข้างบน ไม่ต้องตั้งค่าอะไรเพิ่ม แค่
#   1) เปิด "Google Calendar API" ใน APIs & Services → Library
#   2) กด "ให้สิทธิ์ปฏิทิน" ในแดชบอร์ดอีกครั้ง (token เก่าที่มีแค่สิทธิ์ Gmail ใช้กับปฏิทินไม่ได้)
# โซนเวลาที่ใช้ตีความ "09:00" ที่พิมพ์ตอนสร้างนัด — ควรตรงกับโซนของเบราว์เซอร์
CALENDAR_TZ=Asia/Bangkok

# ---- Slack ----
# สร้างที่ https://api.slack.com/apps → OAuth & Permissions
# ใช้ "User OAuth Token" (ขึ้นต้นด้วย xoxp-) ไม่ใช่ Bot token
# User scopes ที่ต้องขอ: channels:read groups:read im:read
#                        channels:history groups:history im:history users:read
#                        team:read (แนะนำถ้าต่อหลาย workspace — ใช้ทำชื่อกำกับกันชื่อช่องชนกัน)
#
# ต่อได้แค่ workspace เดียวต่อ token หนึ่งตัว (ข้อจำกัดของ Slack)
# ต่อ workspace เดียว: ใส่ที่ตัวนี้ตัวเดียว
SLACK_USER_TOKEN=
# ต่อหลาย workspace: สร้าง Slack app แยกในแต่ละ workspace แล้วคั่น token ด้วย comma ที่นี่แทน (ลบ/ไม่ต้องใช้ตัวบน)
# SLACK_USER_TOKENS=xoxp-workspace1-xxxxx,xoxp-workspace2-xxxxx

# ---- GitHub ----
# สร้างที่ https://github.com/settings/tokens → Tokens (classic) → Generate new token
# scope ที่ต้องติ๊ก: read:user  (เพิ่ม repo ถ้าอยากเห็นคอมมิทใน private repo ด้วย)
# ใช้ GraphQL API เพราะ contribution calendar ไม่มีใน REST
GITHUB_TOKEN=

# ---- Discord ----
# สร้างที่ https://discord.com/developers/applications → New Application → Bot
#   1) เปิด "MESSAGE CONTENT INTENT" ในแท็บ Bot (ไม่งั้นเนื้อความข้อความจะว่างเปล่า)
#   2) คัดลอก token จากแท็บ Bot มาใส่ DISCORD_BOT_TOKEN
#   3) OAuth2 → URL Generator → เลือก scope "bot" + permission View Channel, Read Message History
#      แล้วเปิดลิงก์ที่ได้เพื่อเชิญบอทเข้าเซิร์ฟเวอร์/ห้องที่อยากดึงข้อความ
#   4) เปิด Developer Mode ใน Discord (User Settings → Advanced) แล้วคลิกขวาห้อง → Copy Channel ID
# บอทเป็นบัญชีแยกจากคุณ อ่าน DM ส่วนตัวไม่ได้ — ดึงได้แค่ข้อความในห้องที่เชิญเข้าไป
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# ---- LINE (ส่งสรุปประจำวันเข้าแชทตัวเอง) ----
# สร้างที่ https://developers.line.biz/console/ → Provider → Channel (Messaging API)
#   1) แท็บ Basic settings → Channel access token → Issue → คัดลอกมาใส่ LINE_CHANNEL_ACCESS_TOKEN
#   2) แท็บ Basic settings เลื่อนหา "Your user ID" (User ID ของบัญชีที่ล็อกอินเข้า console — ถ้าใช้ LINE ส่วนตัว
#      สร้างช่องนี้ อันนี้คือ ID ของคุณเอง) → ใส่ LINE_USER_ID
# มีบอท LINE อยู่แล้ว (เช่นจากโปรเจกต์อื่น) ใช้ channel access token ตัวเดิมได้เลย ไม่ต้องสร้างใหม่
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# ---- Server ----
PORT=3000

# แดชบอร์ดไม่มีระบบ login — ใครเปิดหน้านี้ได้ก็อ่านอีเมลกับ Slack ของคุณได้
# ค่า default ผูกกับ loopback อย่างเดียว เครื่องอื่นในวงเน็ตเวิร์กเข้าไม่ถึง
# เปลี่ยนเป็น 0.0.0.0 ก็ต่อเมื่อรู้ว่ากำลังทำอะไรอยู่
HOST=127.0.0.1

# หลังสร้าง .env แล้วปิดสิทธิ์ให้เจ้าของอ่านคนเดียว:
#   chmod 600 .env
